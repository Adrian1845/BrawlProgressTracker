---
// frontend/src/layouts/Layout.astro
import '../styles/results.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #13151a;
    --bg-card: #1a1d24;
    --accent: #ffcb05;
    --accent-hover: #e0b204;
    --text: #ffffff;
    --text-muted: #8a8f98;
    --error: #ff4a4a;
  }

  body {
    background: var(--bg-main);
    color: var(--text);
    font-family: system-ui, -apple-system, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 100vh;
    margin: 0;
    padding: clamp(1rem, 2vw, 2rem);
  }

  .page-shell {
    width: min(100%, 1440px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
