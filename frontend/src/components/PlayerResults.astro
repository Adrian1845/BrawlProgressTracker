---
import AssetImage from './AssetImage.astro';
import BrawlerCatalog from './BrawlerCatalog.astro';
import ProgressMetricGroupTracker from './ProgressMetricGroupTracker.astro';

interface Gear {
  name: string;
  level: number;
}

interface Brawler {
  id: number;
  name: string;
  power: number;
  rank: number;
  trophies: number;
  highestTrophies: number;
  currentWinStreak: number;
  maxWinStreak: number;
  hyperCharges?: any[];
  gears?: Gear[];
}

interface Props {
  data: {
    profile: {
      tag: string;
      name: string;
      nameColor: string;
      icon?: { id: number };
      trophies: number;
      highestTrophies: number;
      expLevel: number;
      "3vs3Victories": number;
      soloVictories: number;
      duoVictories: number;
      rankedRank?: number;
      rankedRankName: string;
      rankedElo?: number;
      club?: { name: string };
      brawlers: Brawler[];
    };
    metrics_v2: {
      max_level: {
        count?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        gold?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        pp?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
      };
      power_11: {
        count?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        gold?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        pp?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
      };
      gadgets: {
        count?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        gold?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        pp?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
      };
      star_powers: {
        count?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        gold?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        pp?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
      };
      gears: {
        count?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        gold?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        pp?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
      };
      buffies: {
        count?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        gold?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        pp?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
      };
      hypercharges: {
        count?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        gold?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
        pp?: {
          current: number;
          total_needed_for_max: number;
          leftover_needed: number;
          percentage_completed: number;
        };
      };
    };
  };
}

const { data } = Astro.props;

if (!data || !data.profile) {
  return null;
}

const { profile, metrics_v2 } = data;
const brawlersList = profile.brawlers || [];
const sortedBrawlers = [...brawlersList].sort((a, b) => b.trophies - a.trophies);
const profileIconSrc = profile.icon?.id ? `/assets/profile/icons/${profile.icon.id}.png` : '/assets/profile/icons/Unknown.png';
const rankedTierId = typeof profile.rankedRank === 'number' ? 58000000 + profile.rankedRank - 1 : null;
const rankedBadgeSrc = rankedTierId !== null ? `/assets/profile/ranked/tiered/${rankedTierId}.png` : '/assets/profile/ranked/regular/Pro.png';
const rankedBadgeFallback = profile.rankedRankName?.split(' ')[0]
  ? `/assets/profile/ranked/regular/${profile.rankedRankName.split(' ')[0]}.png`
  : '/assets/profile/ranked/regular/Pro.png';
---

<div class="results-container">
  
  <header class="profile-header" style={`border-color: ${profile.nameColor ? profile.nameColor.replace('0xff', '#') : '#2a2e37'}`}>
    <div class="avatar-stub">
      <AssetImage
        src={profileIconSrc}
        fallbackSrc="/assets/profile/icons/Unknown.png"
        class="profile-icon"
        alt={`${profile.name} profile icon`}
        loading="eager"
      />
    </div>
    <div class="profile-title">
      <h2 style={`color: ${profile.nameColor ? profile.nameColor.replace('0xff', '#') : '#fff'}`}>
        {profile.name}
      </h2>
      <div class="sub-badges">
        <span class="player-tag">{profile.tag}</span>
        {profile.club?.name && <span class="club-badge">🦎 {profile.club.name}</span>}
      </div>
    </div>
    <div class="rank-badge">
      <span class="lbl">COMPETITIVE</span>
      <div class="rank-badge-row">
        <AssetImage
          src={rankedBadgeSrc}
          fallbackSrc={rankedBadgeFallback}
          class="rank-icon"
          alt={`${profile.rankedRankName ?? 'Rank'} badge`}
          hideOnError={false}
        />
        <div class="rank-badge-copy">
          <span class="val ranked-text">{profile.rankedRankName ?? 'Unranked'}</span>
          <span class="elo">{profile.rankedElo?.toLocaleString() ?? '0'} ELO</span>
        </div>
      </div>
    </div>
  </header>

  <!-- PROGRESSION -->
  <section class="progression-grid">
    <ProgressMetricGroupTracker
      title="Max Level"
      metric={metrics_v2.max_level}
      goldLabel="Gold to Max"
      ppLabel="Power Points to Max"
    />
    <ProgressMetricGroupTracker
      title="Power 11"
      metric={metrics_v2.power_11}
      countLabel="Power 11 Brawlers"
      goldLabel="Gold Invested"
      ppLabel="Power Points Invested"
    />
    <ProgressMetricGroupTracker
      title="Gadgets"
      metric={metrics_v2.gadgets}
      countLabel="Gadgets Owned"
      goldLabel="Gold Invested"
    />
    <ProgressMetricGroupTracker
      title="Star Powers"
      metric={metrics_v2.star_powers}
      countLabel="Star Powers Owned"
      goldLabel="Gold Invested"
    />
    <ProgressMetricGroupTracker
      title="Gears"
      metric={metrics_v2.gears}
      countLabel="Gears Owned"
      goldLabel="Gold Invested"
    />
    <ProgressMetricGroupTracker
      title="Buffies"
      metric={metrics_v2.buffies}
      countLabel="Buffies Owned"
      goldLabel="Gold Invested"
      ppLabel="Power Points Invested"
    />
    <ProgressMetricGroupTracker
      title="Hypercharges"
      metric={metrics_v2.hypercharges}
      countLabel="Hypercharges Owned"
      goldLabel="Gold Invested"
    />
  </section>

  <!-- GLOBAL STATS -->
  <section class="stats-grid">
  <div class="stat-card">
    <AssetImage src="/assets/UI/trophy.png" class="asset-icon-card" alt="Trophies" />
    <div class="stat-info">
      <span class="stat-label">Current Trophies</span>
      <span class="stat-value">{profile.trophies.toLocaleString()}</span>
    </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">🔥</span>
      <div class="stat-info">
        <span class="stat-label">Trophy Record</span>
        <span class="stat-value">{profile.highestTrophies.toLocaleString()}</span>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">⚔️</span>
      <div class="stat-info">
        <span class="stat-label">3vs3 Victories</span>
        <span class="stat-value">{profile["3vs3Victories"].toLocaleString()}</span>
      </div>
    </div>
  </section>

  <BrawlerCatalog brawlers={sortedBrawlers} totalCount={brawlersList.length} />
</div>

<style>
  .results-container {
    width: 100%;
    max-width: 1360px;
    margin: 2rem auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: fadeIn 0.25s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Header */
  .profile-header {
    background: #1b1f27;
    border: 2px solid #2a2e37;
    padding: 1.5rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .avatar-stub {
    background: #101216;
    padding: 0.5rem;
    border-radius: 12px;
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .profile-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .profile-title h2 {
    margin: 0 0 0.25rem 0;
    font-size: 1.8rem;
  }

  .sub-badges {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .player-tag {
    color: #888;
    font-family: monospace;
  }

  .club-badge {
    background: rgba(40, 167, 69, 0.15);
    color: #28a745;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .rank-badge {
    margin-left: auto;
    background: #101216;
    border: 1px solid #2a2e37;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    min-width: 180px;
  }

  .rank-badge .lbl { font-size: 0.65rem; color: #888; }
  .rank-badge .val { font-size: 1.1rem; font-weight: bold; }
  .rank-badge .elo { font-size: 0.8rem; color: #fec325; font-weight: bold; }
  .ranked-text { color: #e03e3e; }

  .rank-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .rank-icon {
    width: 52px;
    height: 52px;
    object-fit: contain;
    flex: none;
  }

  .rank-badge-copy {
    display: flex;
    flex-direction: column;
  }

  /* Progression Module */
  .metrics-card {
    display: none;
  }

  .progression-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* Variaciones de colores de texto */
  .text-gold { color: #fec325; }
  .text-purple { color: #cc8ef5; }
  .text-teal { color: #3be2b0; }
  .text-pink { color: #ff5eb4; }
  .text-needed { color: #ff4a4a; }

  /* Diseños de las barras de progreso */
  .progress-bar-container { background: #101216; height: 5px; border-radius: 3px; width: 100%; overflow: hidden; }
  .progress-bar-container.large { height: 10px; border-radius: 5px; }
  .progress-bar { height: 100%; transition: width 0.3s; }
  
  /* Degradados para cada tipo de barra */
  .gold-bar { background: linear-gradient(90deg, #fec325, #ff9f43); }
  .pp-bar { background: linear-gradient(90deg, #b066fe, #cc8ef5); }
  .gear-bar { background: linear-gradient(90deg, #1abc9c, #3be2b0); }
  .hypercharge-bar { background: linear-gradient(90deg, #ff4a9f, #ff5eb4); }

  /* General Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    background: #1b1f27;
    border: 1px solid #2a2e37;
    padding: 1.25rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .stat-icon { font-size: 1.8rem; }
  .stat-info { display: flex; flex-direction: column; }
  .stat-label { font-size: 0.85rem; color: #888; }
  .stat-value { font-size: 1.3rem; font-weight: bold; color: #fff; }

  .asset-icon-card {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .results-container {
      margin: 1rem auto 0;
    }

    .profile-header {
      padding: 1rem;
      gap: 1rem;
    }

    .profile-title h2 {
      font-size: 1.45rem;
    }

    .rank-badge {
      margin-left: 0;
      width: 100%;
    }

    .rank-badge-row {
      width: 100%;
    }

    .progression-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1600px) {
    .progression-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

</style>
