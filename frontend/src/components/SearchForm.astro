---
---
<div class="search-card">
  <form id="search-form">
    <label for="tag">ENTER PLAYER TAG</label>
    <div class="form-group">
      <input 
        type="text" 
        id="tag" 
        placeholder="e.g. QJY2R0V" 
        required
        maxlength="10"
      />
      <button type="submit" id="search-btn">SEARCH</button>
    </div>
  </form>
  <div class="error-banner" id="error-banner" hidden></div>
</div>

<style>
  .search-card {
    background: var(--bg-card);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid #2a2e37;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    width: min(100%, 640px);
    margin-inline: auto;
    box-sizing: border-box;
  }
  label {
    display: block;
    text-align: left;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  .form-group {
    display: flex;
    gap: 0.5rem;
  }
  input[type="text"] {
    flex: 1;
    background: #101216;
    border: 2px solid #2a2e37;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: white;
    font-size: 1rem;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 1px;
    transition: border-color 0.2s;
  }
  input[type="text"]:focus {
    outline: none;
    border-color: var(--accent);
  }
  button {
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 8px;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
  }
  button:hover {
    background: var(--accent-hover);
  }
  .error-banner {
    background: rgba(255, 74, 74, 0.1);
    border: 1px solid var(--error);
    color: var(--error);
    padding: 0.75rem;
    border-radius: 8px;
    margin-top: 1rem;
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .search-card {
      padding: 1.25rem;
    }

    .form-group {
      flex-direction: column;
    }

    input[type="text"],
    button {
      width: 100%;
    }

    button {
      padding-inline: 1rem;
    }
  }
</style>
