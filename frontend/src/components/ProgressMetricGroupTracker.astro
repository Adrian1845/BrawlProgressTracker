---
import AssetImage from './AssetImage.astro';

interface MetricComparison {
  current: number;
  total_needed_for_max: number;
  leftover_needed: number;
  percentage_completed: number;
}

interface MetricGroup {
  count?: MetricComparison;
  gold?: MetricComparison;
  pp?: MetricComparison;
}

interface Props {
  title: string;
  metric: MetricGroup;
  countLabel?: string;
  goldLabel?: string;
  ppLabel?: string;
}

const {
  title,
  metric,
  countLabel,
  goldLabel,
  ppLabel,
} = Astro.props;

const formatValue = (value: number) => value.toLocaleString();
---

<section class="group-card">
  <h3>{title}</h3>

  <div class="group-stack">
    {metric.count && (
      <div class="group-row group-row-count">
        <div class="row-head">
          <span class="row-label">{countLabel ?? 'Count'}</span>
          <span class="row-value">{formatValue(metric.count.current)} / {formatValue(metric.count.total_needed_for_max)}</span>
        </div>
        <div class="row-meta">
          <span class="row-subtle">{formatValue(metric.count.leftover_needed)} left</span>
          <span class="row-subtle">{metric.count.percentage_completed}% complete</span>
        </div>
        <div class="progress-bar-container large">
          <div class="progress-bar count-bar" style={`width: ${metric.count.percentage_completed}%`}></div>
        </div>
      </div>
    )}

    {metric.gold && (
      <div class="group-row">
        <div class="row-head">
          <span class="row-label">{goldLabel ?? 'Gold'}</span>
          <span class="row-value">
            {formatValue(metric.gold.current)}
            <AssetImage src="/assets/UI/gold.png" class="asset-icon-mini" alt="Gold" />
          </span>
        </div>
        <div class="row-meta">
          <span class="row-subtle">
            {formatValue(metric.gold.leftover_needed)} left
            <AssetImage src="/assets/UI/gold.png" class="asset-icon-mini subtle-icon" alt="Gold needed" />
          </span>
          <span class="row-subtle">{metric.gold.percentage_completed}% complete</span>
        </div>
        <div class="progress-bar-container large">
          <div class="progress-bar gold-bar" style={`width: ${metric.gold.percentage_completed}%`}></div>
        </div>
      </div>
    )}

    {metric.pp && (
      <div class="group-row">
        <div class="row-head">
          <span class="row-label">{ppLabel ?? 'Power Points'}</span>
          <span class="row-value">
            {formatValue(metric.pp.current)}
            <AssetImage src="/assets/UI/power-point.png" class="asset-icon-mini" alt="Power Points" />
          </span>
        </div>
        <div class="row-meta">
          <span class="row-subtle">
            {formatValue(metric.pp.leftover_needed)} left
            <AssetImage src="/assets/UI/power-point.png" class="asset-icon-mini subtle-icon" alt="Power Points needed" />
          </span>
          <span class="row-subtle">{metric.pp.percentage_completed}% complete</span>
        </div>
        <div class="progress-bar-container large">
          <div class="progress-bar pp-bar" style={`width: ${metric.pp.percentage_completed}%`}></div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .group-card {
    background: #1b1f27;
    border: 1px solid #2a2e37;
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .group-card h3 {
    margin: 0;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 700;
    border-left: 4px solid #fec325;
    padding-left: 0.5rem;
  }

  .group-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .group-row {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .row-head,
  .row-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .row-label {
    color: #8a8f98;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .row-value {
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .row-subtle {
    color: #8a8f98;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .progress-bar-container {
    background: #101216;
    height: 6px;
    border-radius: 999px;
    width: 100%;
    overflow: hidden;
  }

  .progress-bar-container.large {
    height: 10px;
  }

  .progress-bar {
    height: 100%;
    transition: width 0.3s ease;
  }

  .count-bar {
    background: linear-gradient(90deg, #607d8b, #90a4ae);
  }

  .gold-bar {
    background: linear-gradient(90deg, #fec325, #ff9f43);
  }

  .pp-bar {
    background: linear-gradient(90deg, #b066fe, #cc8ef5);
  }

  .asset-icon-mini {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .subtle-icon {
    opacity: 0.8;
  }
</style>
