---
import Layout from '../layouts/Layout.astro';
import SearchForm from '../components/SearchForm.astro';
import PlayerResults from '../components/PlayerResults.astro';
import { API_BASE_URL } from '../config';

let playerData = null;
let errorMessage = "";

const rawTag = Astro.url.searchParams.get("tag")?.trim() || "";
const searchTag = rawTag.startsWith("#") ? rawTag.slice(1) : rawTag;

if (searchTag) {
  try {
    const response = await fetch(`${API_BASE_URL}/api/player/${searchTag}`);
    
    if (!response.ok) {
      errorMessage = response.status === 404 
        ? `Player tag #${searchTag} not found.` 
        : "Failed to communicate with the backend tracker engine.";
    } else {
      playerData = await response.json();
    }
  } catch (error) {
    errorMessage = "An unexpected connection error occurred.";
    console.error(error);
  }
}
---

<Layout title="Brawl Progress Tracker">
  <main class="page-shell">
    <header class="page-hero">
      <h1>Brawl Tracker</h1>
      <p>Progression Analyst</p>
    </header>

    <SearchForm searchTag={searchTag} errorMessage={errorMessage} />

    {playerData && <PlayerResults data={playerData} />}
  </main>
</Layout>

<style>
  .page-hero {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .page-hero h1 {
    color: var(--accent);
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .page-hero p {
    color: var(--text-muted);
    margin: 0.5rem 0 0;
  }
</style>
